# разработчик - студент Скибицкий М. Е.

import tkinter as tk
from gui_auth import AuthGUI
from gui_admin import AdminGUI
from gui_developer import DeveloperGUI
from resume_analyzer_app import ResumeAnalyzerApp


class Application:
    def __init__(self):
        self.auth_root = None
        self.current_window = None

    def run(self):
        self.show_auth_window()

    def show_auth_window(self):
        if self.current_window:
            self.current_window.destroy()

        self.auth_root = tk.Tk()
        self.current_window = self.auth_root
        AuthGUI(self.auth_root, self.on_successful_login)
        self.auth_root.mainloop()

    def on_successful_login(self, username, role, bg_color, font_size, font_weight):
        if self.auth_root:
            self.auth_root.quit()  # Выходим из mainloop вместо destroy
            self.auth_root.destroy()

        if role == "user":
            app_root = tk.Tk()
            self.current_window = app_root
            ResumeAnalyzerApp(app_root, username, bg_color, font_size, font_weight)
            app_root.mainloop()
        elif role == "admin":
            admin_root = tk.Tk()
            self.current_window = admin_root
            AdminGUI(admin_root, username)
            admin_root.mainloop()
        elif role == "developer":
            dev_root = tk.Tk()
            self.current_window = dev_root
            DeveloperGUI(dev_root, username)
            dev_root.mainloop()

def main():
    app = Application()
    app.run()

if __name__ == "__main__":
    main()
